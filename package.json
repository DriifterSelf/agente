{
  "name": "agente-studio",
  "version": "1.0.1",
  "description": "Agente Autónomo de Oficina y Sistema",
  "author": "DriifterSelf",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:frontend": "vite build",
    "lint": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "electron:start": "electron .",
    "build:win": "vite build && electron-builder --win",
    "dist": "vite build && electron-builder --win -p always"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "electron-updater": "^6.3.9",
    "express": "^5.3.0",
    "lucide-react": "^0.475.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.agente.studio",
    "productName": "Agente Studio",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DriifterSelf",
        "repo": "agente",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    }
  }
}